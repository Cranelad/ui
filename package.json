      "optional": true
    }
  },
  "devDependencies": {
    "@tabler/icons-webfont": "3.49.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "bootstrap": "^5.3.8",
    "jsdom": "^26.1.0",
    "sass": "^1.105.1",
    "subset-font": "2.9.0",
    "vite": "^7.3.7",
    "vitest": "^4.1.12",
    "vue": "^3.5.44"
  }
}
