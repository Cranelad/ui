    "build:icons": "node scripts/build-icons.mjs"
  },
  "peerDependencies": {
    "bootstrap": "^5.3.8",
    "element-plus": "^2.0.0",
    "vue": "^3.4.0"
  },
  "peerDependenciesMeta": {
