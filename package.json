{
  "name": "@cranelad/ui",
  "version": "0.2.0",
  "description": "Cranelad's internal Vue 3 UI kit and theme (based on Vue Now UI Kit, on Bootstrap 5)",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/Cranelad/ui.git"
  },
  "type": "module",
  "sideEffects": [
    "*.css",
    "*.scss"
  ],
  "exports": {
    ".": "./src/index.js",
    "./style.scss": "./src/scss/index.scss",
    "./style-element-plus.scss": "./src/scss/element-plus.scss",
    "./tokens.scss": "./src/scss/tokens.scss",
