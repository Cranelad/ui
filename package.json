{
  "name": "@cranelad/ui",
  "version": "0.1.0",
  "description": "Cranelad's internal Vue 3 UI kit and theme (based on Vue Now UI Kit, on Bootstrap 5)",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "sideEffects": [
    "*.css",
    "*.scss"
  ],
  "exports": {
    ".": "./src/index.js",
    "./bootstrap.scss": "./src/scss/bootstrap.scss",
    "./theme.scss": "./src/scss/now-ui-kit.scss",
    "./demo.css": "./src/css/demo.css",
    "./scss/*": "./src/scss/*"
  },
  "files": [
    "src",
    "LICENSE",
    "README.md"
  ],
  "peerDependencies": {
    "bootstrap": "^5.3.8",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "bootstrap": "^5.3.8",
    "sass": "^1.105.1",
    "vue": "^3.5.44"
  }
}
